# Copy to .env and edit. Never commit .env.

# Which MT5 terminal to attach to. Leave empty to use the already-open terminal.
# Examples:
#   C:\Program Files\MetaTrader 5 IC Markets Global\terminal64.exe
#   D:\exness\terminal64.exe
#   C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# Optional login if you want the research process to log in itself.
# Safer: open MT5, log in, then run `python -m ats doctor`.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Groq API key for the automated hypothesis brainstorm (free, no card required).
# Sign up: console.groq.com → API Keys → Create API Key
# Usage:   python -m ats intake groq-brainstorm --category forced_flow --n 5
GROQ_API_KEY=
